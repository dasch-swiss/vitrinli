# Test and binary images (all formats, including small PNGs)
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.JPG filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.jp2 filter=lfs diff=lfs merge=lfs -text
*.jpx filter=lfs diff=lfs merge=lfs -text
*.j2k filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.icc filter=lfs diff=lfs merge=lfs -text
*.icm filter=lfs diff=lfs merge=lfs -text

# Fonts
*.ttf filter=lfs diff=lfs merge=lfs -text
*.woff filter=lfs diff=lfs merge=lfs -text

# The ICC profiles that //tools:bin2c compiles into the binary are plain git
# objects, so a checkout without `git lfs pull` still builds a correct sipi.
include/ICC-Profiles/AdobeRGB1998.icc -filter -diff -merge -text
include/ICC-Profiles/USWebCoatedSWOP.icc -filter -diff -merge -text
include/ICC-Profiles/YCC709.icm -filter -diff -merge -text
include/ICC-Profiles/Rec709-Rec1886.icc -filter -diff -merge -text
