# Sipi Bazel configuration — Bazel version pinned in .bazelversion.
#
# Defaults in Bazel 9 (do NOT re-declare):
#   --enable_bzlmod                          (default in 9)
#   --incompatible_enable_cc_toolchain_resolution  (default in 9)
#
# Kept here as a documented cache-hygiene anchor — strict action env stops
# unrelated host env vars (e.g. GitHub-injected GITHUB_RUN_ID) from poisoning
# Bazel's cache keys across CI runs.
build --incompatible_strict_action_env

# Force the resolved toolchain (the hermetic `llvm` toolchain in MODULE.bazel)
# instead of Bazel's autodetected host C++ toolchain. Without this, Bazel can
# fall back to the host clang/gcc when toolchain resolution misfires, which
# silently breaks hermeticity. (Candidate for removal under the hermetic
# toolchain — a properly registered toolchain shouldn't fall back; left in
# place until the swap is proven green on all platforms, then test-removed.)
build --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# macOS repo-rule SDK. rules_python's pip sdist path (e.g. rules_fuzzing's
# absl-py, pulled in by the fuzz harness) shells out to `xcrun xcodebuild
# -showsdks` to locate an SDK, which the Nix dev shell's apple-sdk stub can't
# satisfy (no `xcodebuild`) — the fetch dies with "tool 'xcodebuild' not found".
# Pointing the repo-rule DEVELOPER_DIR at the Command Line Tools makes
# rules_python take its non-Xcode branch (path contains "CommandLineTools", so
# it derives the SDK directly and skips the `xcodebuild` call). `--repo_env`
# scopes this to repository-rule evaluation only — build actions compile against
# the hermetic-llvm SDK and are unaffected (verified: adding this leaves a warm
# `//src/cli:sipi` a 100% action-cache hit). No-op on Linux, where rules_python's
# SDK probe never runs.
build --repo_env=DEVELOPER_DIR=/Library/Developer/CommandLineTools

# Inherit PATH from the invocation environment. `--incompatible_strict_action_env`
# above otherwise rebuilds PATH from a small allow-list (`/bin:/usr/bin:/usr/local/bin`),
# which omits the Nix dev-shell's `/nix/store/…/bin` entries. Inheriting PATH
# keeps the dev-shell tools (e.g. `git` for `tools/workspace_status.sh`)
# reachable without scattering toolchain paths across the action's env.
build --action_env=PATH

# Stamp inputs for reproducible binaries and OCI images. The script writes
# STABLE_GIT_COMMIT, STABLE_GIT_VERSION, STABLE_IMAGE_CREATED, and
# STABLE_SIPI_VERSION (sourced from version.txt) — consumed by
# expand_template(..., stamp_substitutions = {...}) in src/BUILD.bazel.
build --workspace_status_command=tools/workspace_status.sh

# Auto-apply :macos / :linux config blocks below by detected host platform.
build --enable_platform_specific_config

# C++23 — same target as the existing CMake build (see CLAUDE.md
# "Compiler Requirements: C++23").
build --cxxopt=-std=c++23
build --host_cxxopt=-std=c++23

# Force static linking for cc_binary / cc_test on Linux. cc_test on
# Linux defaults to dynamic linking, which makes Bazel emit a `.so`
# for every transitive cc_library and links each test against those
# DSOs. That collides with two realities of this build:
#   * the native `cc_library` deps (e.g. exiv2) ship a static `.a` only —
#     Bazel's auto-DSO for `//src:sipi_lib` then references their symbols
#     across a DSO boundary, and the linker rejects them as
#     "non-exported symbol 'Exiv2::…' in libexiv2.a is referenced by
#     DSO libsrc_Slibsipi_Ulib.so".
#   * the hermetic toolchain's `libc++.a` carries non-PIC relocations on
#     aarch64, so even when `.so` linking is otherwise correct, the
#     C++ stdlib pull-in fails with `recompile with -fPIC`.
# Static linking matches `bazel build //src:sipi` (which already
# defaults to static via `cc_binary`'s `linkstatic=True`), so cc_test
# behaves the same way as the production binary it tests against.
# darwin is unaffected: its default is already mostly static.
build:linux --dynamic_mode=off

# `__isoc23_strtol` / `fcntl64` glibc-2.39 → glibc-2.31 aliases are
# provided by `//bazel:glibc23_compat` (Linux-only cc_library, propagated
# via `//src:sipi_lib`'s deps select). The earlier `--linkopt=-Wl,--defsym`
# approach was rejected because `--linkopt` flows into every link
# action where neither side of the alias is yet linked, producing
# `--defsym:1: symbol not found: strtol`.

# ── Hardening (production target binary) ───────────────────────────────────
# Re-enables stack-protector-strong, fortify-source, stack-clash protection,
# and BindNow for the publicly-deployed sipi binary (DEV-6282). PIE/PIC are
# already on by toolchain default since DEV-6348.
#
# Host config is deliberately left unhardened — host-built tools (e.g.
# libmagic's `file` bootstrap that generates magic.mgc, protoc, etc.) are
# never deployment artifacts, and `-D_FORTIFY_SOURCE=2` conflicts with
# libmagic 5.47's `file.h:666` (glibc's `__dprintf_chk` fortified macro vs
# libmagic's own dprintf-related declaration). Hardening host tools adds
# no security value, so the simpler course is to keep host config clean.
#
# Sanitizer (`--config=asan`/`--config=ubsan`) builds keep target hardening
# off — `_FORTIFY_SOURCE=2` intercepts the same libc functions ASan does
# (memcpy/memmove/etc.), and the instrumentation already subsumes the stack
# canary's intent. The per-config overrides further down ensure those compile
# lines do NOT carry the new hardening flags.
build --copt=-fstack-protector-strong
# `_FORTIFY_SOURCE=2` lives in `--config=release` (just below), NOT the global
# `build` config: it requires optimization, so at the default fastbuild `-O0` it
# does nothing but emit a glibc `#warning` on every TU (huge CI log spam).
# Release-only keeps dev / fastbuild / CI builds quiet.
#
# ── Release (production) build config ────────────────────────────────────────
# `--config=release` IS the production build — the Docker image recipes
# (`just bazel-docker-build/push-*`, `bazel-docker-extract-debug`) use it:
# `-c opt` codegen + `_FORTIFY_SOURCE=2` hardening. The hermetic-llvm toolchain's
# opt feature injects `-D_FORTIFY_SOURCE=1`; we undef then redefine to 2
# (undef-then-define avoids `-Wmacro-redefined`). libmagic 5.47 conflicts with the
# fortified glibc headers, so undo FORTIFY for its TUs only (substring match — no
# other source path contains "libmagic"; an anchored `^external/libmagic\+/…$`
# form fails to match in `.bazelrc`, verified via aquery).
build:release --compilation_mode=opt
build:release --copt=-U_FORTIFY_SOURCE
build:release --copt=-D_FORTIFY_SOURCE=2
build:release --per_file_copt=libmagic@-U_FORTIFY_SOURCE

# Debug info for crash symbolication (DEV-6659). `-c opt` emits no DWARF on
# its own, so a stripped-minidump crash resolved to bare addresses / at best
# function names from `.symtab`. Line tables (C++ `-gline-tables-only` + Rust
# `-Cdebuginfo=1`) make the release binary carry the address→file:line DWARF a
# crash backtrace needs; `//src:sipi_debug_split` splits it out with
# `--only-keep-debug` into the `.debug` uploaded to Sentry and ships the
# stripped binary in the image (`:sipi_bin_layer`), so the DWARF lives only in
# the uploaded symbols, never in the shipped binary. Line-tables-only (not full
# `-g`) keeps the `.debug` and the release link an order of magnitude smaller
# while preserving file:line frames; it omits inlined-frame expansion + locals,
# which a stack symbolication does not need. Restores the file:line the
# pre-Bazel (Nix `separateDebugInfo`) build had.
build:release --copt=-gline-tables-only
# Emit Rust line tables (`debuginfo=1`) AND override rules_rust's opt-mode
# `-Cstrip=debuginfo`, which otherwise strips the DWARF (both Rust's and the
# linked-in C++ engine's) out of the final rust_binary link — Bazel's
# `--strip=never` does NOT reach the rustc link. rustc `-C` options are
# last-wins and these are appended after the rule defaults, so `strip=none`
# wins; `:sipi_debug_split` then has DWARF to extract and re-strips the
# shipped binary itself. (Repeating the flag overrides, so both go in one
# comma-separated value.)
build:release --@rules_rust//rust/settings:extra_rustc_flags=-Cdebuginfo=1,-Cstrip=none
# --strip=never keeps DWARF through the C++ (clang-driven) link of //src/cli:sipi
# for the same reason (that path DOES honour Bazel --strip).
build:release --strip=never

# Linux-only: stack-clash-protection is a clang-on-Linux feature (warns
# harmlessly on a darwin cross-compile). Its companion `-Wl,-z,now` linkopt
# lives in //src:sipi_lib's (and :engine's) target-keyed linkopts select
# instead: a linkopt must key on the TARGET os, not the host, or a Linux-host
# cross-compile to darwin hands `-z` to ld64.lld, which rejects it.
build:linux --copt=-fstack-clash-protection

# ── macOS ──────────────────────────────────────────────────────────────────
# Pin the deployment target so Bazel-built binaries are portable across macOS
# releases. The hermetic `llvm` toolchain fetches the MacOSX26.5 SDK from
# Apple's CDN; a recent SDK otherwise defaults the deployment target high, so
# pin the floor explicitly. macOS builds serve development and the macos-15 CI
# leg only; production is Linux. Keep the floor at or above the deployment
# target hermetic-llvm gives cc-rs build-script objects (`ring`, 14.0), which
# `MACOSX_DEPLOYMENT_TARGET` below does not reach, or ld64.lld warns on every
# Rust link.
build:macos --copt=-mmacosx-version-min=14.0
build:macos --linkopt=-mmacosx-version-min=14.0
build:macos --host_copt=-mmacosx-version-min=14.0
build:macos --host_linkopt=-mmacosx-version-min=14.0
build:macos --action_env=MACOSX_DEPLOYMENT_TARGET=14.0

# Inherit PATH during repo-rule evaluation on macOS so the Kakadu
# `gh_release_archive` fetch (needs `gh` from the Nix dev shell) stays
# reachable. hermetic-llvm manages its own libc++ and fetches the SDK from
# Apple's CDN, so no SDK/xcrun env overrides are needed.
build:macos --repo_env=PATH

# Pin an explicit locale for test actions on macOS hosts. The Nix dev-shell
# bash (5.3, linked against CoreFoundation) segfaults ~10-25% of runs inside
# the Bazel test wrapper while disposing locale env vars:
# dispose_temporary_env → libintl_setlocale → CFLocaleCopyPreferredLanguages
# → _os_log_preferences_refresh (SIGSEGV). It fires at teardown after the tests
# pass, so Bazel reports the target (e.g. //test/e2e:bilevel_tiff) as a flaky
# segfault with zero sipi frames involved. An explicit LC_ALL makes setlocale
# skip the CoreFoundation default-locale resolution and sidesteps the crash
# (verified: 0 crashes vs a ~2/20 baseline). `test:macos` (auto-applied by
# `--enable_platform_specific_config` above) scopes this to macOS hosts — local
# dev and the darwin CI legs, which run the same bash — and never touches the
# Linux CI/RBE legs, where bash does not link CoreFoundation and cannot hit this.
test:macos --test_env=LC_ALL=C

# Force `rules_android`'s `android_sdk_repository_extension` to take the
# empty-SDK branch instead of validating an actual Android SDK install.
# `rules_android` is pulled transitively by `protobuf` (BCR) and its
# `@androidsdk//:all` toolchain registration runs at toolchain-resolution
# time for *every* target — even pure C++ ones. The extension reads
# `ANDROID_HOME` and fails with "No Android SDK apis found …" when the
# path exists but has no `platforms/android-XX` subdirs. GitHub Actions
# runners pre-set `ANDROID_HOME=/usr/local/lib/android/sdk` (Linux) or
# `/Library/Android/sdk` (macOS) without populated platforms, so the
# check tanks every CI build until we explicitly clear it for Bazel.
#
# The bypass is in rules_android 0.7.x's
# `_android_sdk_repository_impl`: an unset/empty `ANDROID_HOME` falls
# through to the empty-SDK template path (`return None`), satisfying
# the toolchain registration without requiring real Android tooling.
# Local dev with a real Android SDK is unaffected — devs don't typically
# set ANDROID_HOME for SIPI work, and if they do they can override on
# the command line.
common --repo_env=ANDROID_HOME=

# ── Sanitizers — opt-in via --config=asan and/or --config=ubsan ─────────────
# Replaces the deleted `.#sanitized` Nix variant. CI's `sanitizer` job (in
# ci.yml) runs both together in one invocation, `just bazel-test-sanitized
# --config=asan --config=ubsan`, covering unit and e2e tests; e2e tests pick
# up LSan suppressions via the `//:lsan_suppressions` target
# (`.lsan_suppressions.txt`), wired into `LSAN_OPTIONS` by the e2e test rule.
# `just bazel-build-sanitized` builds `//src/cli:sipi`
# (`bazel-bin/src/cli/sipi`) for local dev. The two configs are kept separate
# so a developer can isolate a finding to ASan vs UBSan.
#
# `--compilation_mode=dbg` matches the prior Nix variant's `Debug` cmake
# build and gives us `-g -O0` (clearer ASan stack traces and no compiler
# elision of UBSan checks); `--strip=never` keeps DWARF inline so LSan's
# symbol-name suppressions (`leak:lua*` in `.lsan_suppressions.txt`)
# actually match — the same invariant the old override enforced via
# `dontStrip = true` + `separateDebugInfo = false`.
#
# **Instrumentation via the toolchain's `--@llvm//config:{asan,ubsan}`
# flags** (DEV-6563). Setting `--@llvm//config:asan=true` makes
# the hermetic-llvm toolchain (a) add `-fsanitize=address` to every
# target compile + link, (b) put the compiler-rt `sanitizer/*.h` headers
# on the include path (abseil's `dynamic_annotations.h` includes
# `sanitizer/common_interface_defs.h` whenever ASan is active), and
# (c) build + link the compiler-rt ASan runtime from source. The three
# are bundled in the one flag — the toolchain has no "provide the runtime
# but let me scope the instrument myself" knob. ADR-0014 carved this gate
# out precisely because the minimal prebuilt shipped no runtime;
# foreign_cc=0 (ADR-0015) then removed the global-instrument blocker
# (no CMake compiler-detection links left to break), so the toolchain
# flag is now the supported re-arm path. `--config=ubsan` is the same
# shape (`-fsanitize=undefined` + the toolchain's own ignorelist).
#
# This instruments the native deps (kakadu / libtiff / openssl / …) too,
# not only first-party code — broader than the old `--per_file_copt`
# scoping, which the toolchain cannot reproduce (provisioning the runtime
# forces the global flag). For a sanitizer *gate* that is strictly more
# coverage (it catches memory errors in how sipi drives the deps); the
# cost is a from-scratch instrumented build (compiler-rt from source +
# every dep), amortised by the remote cache. The vptr check now links
# cleanly — hermetic-llvm builds + statically links `libubsan_standalone`
# (incl. the C++ runtime) from source, so the old `-fno-sanitize=vptr`
# workaround (toolchains_llvm shipped only the dynamic ubsan-cxx runtime)
# is gone. Darwin remains unsupported (the macOS toolchain args omit the
# sanitizer header path); the gate runs on linux-x86_64.

# Neutralize the production hardening flags (`build --copt=…` block above)
# for sanitizer builds. `_FORTIFY_SOURCE=2` intercepts the same libc
# functions ASan does (memcpy/memmove/etc.), causing duplicate-symbol or
# poisoned-memory conflicts; stack-protector is subsumed by ASan's
# stack-frame redzones. The `--copt` flags below are appended AFTER the
# global `build --copt=…` block, and the compiler's "last wins" precedence
# (for `-U_FORTIFY_SOURCE` after `-D_FORTIFY_SOURCE=2`, and
# `-fno-stack-protector` after `-fstack-protector-strong`) yields a clean
# un-hardened compile line. Verified via
#   bazel aquery --config=asan 'mnemonic("CppCompile", //src/cli:sipi)'
# 2026-05-26.
build:asan --copt=-U_FORTIFY_SOURCE
build:asan --copt=-fno-stack-protector
build:asan --compilation_mode=dbg
build:asan --strip=never
build:asan --@llvm//config:asan=true

# ASan runtime env for `bazel test --config=asan`. `detect_leaks=1` keeps
# LSan on; LSan runs at process exit and a detected leak makes the process
# exit non-zero, so Bazel fails the test. The report goes to stderr, i.e.
# the test's test.log (`--test_output=errors` prints it in CI). Do not set
# `halt_on_error=0` — that switches ASan to a recoverable leak check that
# reports and exits 0. Do not set `log_path` — Bazel does not expand `$VAR`
# in `--test_env`, so the path is literal and the report never lands in
# `test.outputs`.
test:asan --test_env=ASAN_OPTIONS=detect_leaks=1
# The Lua request deadline (default 5s) assumes production-speed engine calls;
# under ASan's 10-20x slowdown a TIFF->JP2 upload conversion outlives it and
# the post-call deadline check kills the route (upload e2e all-500). The
# spawned sipi inherits the test env, so raise the deadline for sanitizer runs
# only. Tests that probe the kill behavior itself pass an explicit
# SIPI_LUA_TIMEOUT_MS via start_env, which overrides this.
test:asan --test_env=SIPI_LUA_TIMEOUT_MS=120000

# ASAN_SYMBOLIZER_PATH is NOT forwarded from the client env here: the e2e test
# macro (`test/e2e/sipi_e2e_test.bzl`) attaches `//bazel:llvm-symbolizer` as a
# runfile under `--config=asan` and sets the env to its runfiles-relative path,
# so LSan symbolization works when the test executes on the RBE worker (a
# runner-side absolute path would not exist there).

# Neutralize production hardening for UBSan — same rationale as `build:asan`.
build:ubsan --copt=-U_FORTIFY_SOURCE
build:ubsan --copt=-fno-stack-protector
build:ubsan --compilation_mode=dbg
build:ubsan --strip=never
build:ubsan --@llvm//config:ubsan=true

# openssl (crypto/stack/stack.c's OPENSSL_sk_pop_free) and xz
# (liblzma/common/filter_common.c's encoder_find) both call through a
# function pointer cast to a differently-typed prototype — the standard C
# idiom for a generic callback slot, not a SIPI defect — which trips UBSan's
# `function` check (clang >= 17 enables it under `undefined`). Both are BCR
# deps fetched read-only (`bazel_dep` on openssl/xz), so there is no BUILD
# file of ours to attach a per-target `copts` override to, unlike the
# first-party-vendored `bazel/lcms2.BUILD.bazel`/`bazel/kakadu.BUILD.bazel`
# pattern. `--per_file_copt` reaches into their compile actions by source
# path instead; only the `function` subcheck is dropped for these two
# repos, everything else stays on for them and for the rest of the build.
# Split into its own config so every config that turns on UBSan
# (`--config=ubsan`, `--config=fuzz`) can pull it in rather than duplicate it.
build:ubsan_thirdparty --per_file_copt=external/openssl[+]/.*[.]c$,external/xz[+]/.*[.]c$@-fno-sanitize=function
build:ubsan --config=ubsan_thirdparty

# UBSan runtime env for `bazel test --config=ubsan`. UBSan recovers by
# default (prints the report and continues), so a finding would never fail
# its test. `halt_on_error=1` makes the first finding exit the process
# non-zero, failing a unit test directly, and making an e2e test's spawned
# sipi exit non-zero (the e2e harness fails on that and prints its captured
# stderr); spawned processes inherit the test env. `print_stacktrace=1` puts
# a stack in the report. No suppressions file is used here — a third-party
# finding is fixed at the build level instead.
test:ubsan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1

# ── Tracy profiler — opt-in via --config=tracy ─────────────────────────────
# Local-dev only, never CI-gated (like `just bench` / `just valgrind`).
# `just bazel-build-tracy` adds `-c opt` and builds //src/cli:sipi; run the
# binary and connect the Tracy GUI over TCP 8086. The `@tracy//:tracy` dep is
# always in the graph but inert until TRACY_ENABLE is defined here, so these
# flags are the *only* thing that arms the profiler.
#
#   * TRACY_ENABLE   — master switch. Defined globally so it reaches both
#     TracyClient.cpp and every instrumented first-party TU (the zone macros in
#     `src/observability/cpp/profiling.h` are no-ops without it).
#   * TRACY_ON_DEMAND — a long-running server must not buffer profiling data
#     when no GUI is attached; with this, collection starts only on connect.
#   * -fno-omit-frame-pointer + -g + --strip=never — symbol-accurate zones and
#     enable Tracy's statistical call-stack sampling alongside the manual zones.
build:tracy --copt=-DTRACY_ENABLE
build:tracy --copt=-DTRACY_ON_DEMAND
build:tracy --copt=-fno-omit-frame-pointer
build:tracy --copt=-g
build:tracy --strip=never
# Tracy's headers (pulled into instrumented first-party TUs via profiling.h) trip
# -Wthread-safety-analysis on their lock-free queue internals. Vendored code we
# don't maintain; silence it for this dev-only config (the warning still applies
# to first-party code in the normal/sanitizer builds).
build:tracy --copt=-Wno-thread-safety-analysis

# ── Fuzzing — opt-in via --config=fuzz ─────────────────────────────────────
# Arms `//src/iiifparser/fuzz:parse_request_fuzz` with the real libFuzzer engine
# for `just bazel-build-fuzz` / `just fuzz` and the nightly loop. WITHOUT this
# config the target uses rules_fuzzing's default `replay` engine
# (instrumentation `none`, no runtime needed), so it builds and corpus-replays on
# every platform and rides along in the `//src/...` test sweeps — the
# build-completeness invariant holds by default and only this config needs the
# runtime.
#
# **Linux + macOS.** Since 0.8.18, hermetic-llvm stages the compiler-rt
# libFuzzer runtime for darwin too (`libclang_rt.fuzzer_osx.a`, upstream PR #700), so
# `-fsanitize=fuzzer` links on macOS as well as Linux. The driver also pulls
# `libclang_rt.ubsan_osx_dynamic` on darwin, so `config:ubsan=true` below is
# required on both. (rules_fuzzing's Python launcher deps also need a macOS
# repo-rule DEVELOPER_DIR to resolve in the Nix dev shell — set globally near the
# top of this file, not here, since the plain replay build needs it too.) The
# broader `--config=fuzz --config=asan` pairing is a separate runtime and stays
# Linux-only — the macOS ASan header path is still gapped (§Sanitizers above).
#
# **ASan pairing** is `--config=fuzz --config=asan`: the two compose because the
# rules_fuzzing transition re-emits `--copt`/`--linkopt` (so `build:asan`'s
# `-U_FORTIFY_SOURCE` / `-fno-stack-protector` survive) while
# `--@llvm//config:asan=true` passes through it untouched. rules_fuzzing's own
# `--@rules_fuzzing//fuzzing:cc_engine_sanitizer` must stay at its `none`
# default — it injects `-fsanitize=…` without provisioning a runtime, and
# hermetic-llvm stages `libclang_rt.asan*` only under `config:asan=true`. Note
# the scope: ASan instruments the C++ shim, libFuzzer itself, and the linked
# native runtime — not the Rust crate graph (that needs nightly `-Zsanitizer`,
# which this design avoids).
build:fuzz --@rules_fuzzing//fuzzing:cc_engine=@rules_fuzzing//fuzzing/engines:libfuzzer
build:fuzz --@rules_fuzzing//fuzzing:cc_engine_instrumentation=libfuzzer

# Fuzzing throughput is the budget: a nightly run has a fixed wall-clock
# window, so execs/s is coverage. `-c opt` is worth several times the
# `fastbuild` default here, and unlike a normal build there is nothing to
# debug in a stepping debugger — a finding is a saved reproducer, replayed
# separately.
build:fuzz --compilation_mode=opt

# The libFuzzer runtime, built from source by the toolchain — the same
# compiler-rt machinery `--config=asan` uses. `config:ubsan` is required, not
# optional: the clang driver links `libclang_rt.ubsan_standalone` for
# `-fsanitize=fuzzer`, and only `config:ubsan=true` stages that archive into the
# resource directory.
build:fuzz --@llvm//config:fuzzer=true
build:fuzz --@llvm//config:ubsan=true

# Same openssl/xz `function`-check exclusion as `build:ubsan` — see
# `build:ubsan_thirdparty` above; `--config=fuzz` arms UBSan independently of
# `--config=ubsan` (it does not compose with it) so it needs its own pull-in.
build:fuzz --config=ubsan_thirdparty

# SanitizerCoverage for the Rust crate graph — all stable rustc flags (no
# `-Zsanitizer`, no nightly). The **singular** `extra_rustc_flag` is required:
# it accumulates across occurrences, whereas each `extra_rustc_flags` (plural)
# occurrence REPLACES the whole list, so a plural block silently keeps only its
# last line. Target config only; exec-config proc-macros and build scripts are
# untouched (`extra_exec_rustc_flags` is the separate exec-config setting).
build:fuzz --@rules_rust//rust/settings:extra_rustc_flag=-Cpasses=sancov-module
build:fuzz --@rules_rust//rust/settings:extra_rustc_flag=-Cllvm-args=-sanitizer-coverage-level=4
build:fuzz --@rules_rust//rust/settings:extra_rustc_flag=-Cllvm-args=-sanitizer-coverage-inline-8bit-counters
build:fuzz --@rules_rust//rust/settings:extra_rustc_flag=-Cllvm-args=-sanitizer-coverage-pc-table
build:fuzz --@rules_rust//rust/settings:extra_rustc_flag=-Cllvm-args=-sanitizer-coverage-trace-compares

# `-c opt` above turns both of these OFF by default, and they are exactly the
# bug class this target hunts: an integer overflow in a coordinate/dimension
# parser is a debug-build panic and a silent wraparound in release. Turning
# them back on makes the fuzzer see the panic.
#
# NOT `-Cpanic=abort`: it is config-wide, so it would break
# `bazel test --config=fuzz` on every Rust test target (the prebuilt sysroot's
# `test` crate is unwind-compiled). Nothing is lost — a Rust panic unwinding
# out of an `extern "C"` fn has aborted since Rust 1.71, so the
# panic→SIGABRT→libFuzzer-crash path through `sipi_fuzz_parse_request` is
# guaranteed by the language, not by this flag.
build:fuzz --@rules_rust//rust/settings:extra_rustc_flag=-Cdebug-assertions=on
build:fuzz --@rules_rust//rust/settings:extra_rustc_flag=-Coverflow-checks=on

# ── Test ───────────────────────────────────────────────────────────────────
# Surface test stderr immediately on failure rather than collecting it into
# bazel-testlogs — useful for inner-loop iteration. CI flips this off.
test --test_output=errors

# Retry the timing-sensitive e2e tests up to 3x — the single retry mechanism
# for the suite (replaces the bespoke Rust `retry_flaky` helper / inline poll
# loops, removed in favour of Bazel's native `--flaky_test_attempts`). These
# six assert on server-side timing the test can't pin down deterministically:
#   - latency / iiif_compliance / resource_limits: connection / cache budgets a
#     loaded CI runner (observed on linux-arm64) blows on a single attempt —
#     surfacing as a transient `hyper::Error(IncompleteMessage)`.
#   - memory_budget / resource_limits: an eventually-consistent state settling
#     just after the response (the decode-budget gauge returning to 0; the musl
#     binary recovering after a heavy transform pipeline).
#   - server: lua_test_functions / lua_uuid_round_trip intermittently 503 under
#     suite-load bursts when the engine-pool semaphore sheds (routes.rs
#     `try_acquire_owned`); the deterministic 503 cases in `server` are
#     `#[ignore]`'d (DEV-6659), so only this transient residue
#     remains here. Root cause to revisit in future concurrency work.
#   - upload: concurrent_file_uploads' post-burst responsiveness probe 503s when
#     the upload burst's permits have not yet been released (same engine-pool
#     semaphore; passes 3/3 in isolation, sheds only under parallel-suite load).
# A genuinely broken test still fails all 3 attempts, so this masks flakes, not
# regressions. `--flaky_test_attempts` is `accumulate_value` (one entry per
# target) and matches the target label as a regex; a no-op for invocations that
# don't include the target. Living in `.bazelrc` (not a per-workflow flag)
# means ci.yml's test and `sanitizer` jobs and local `just bazel-test` all
# inherit it — single source of truth (the `sanitizer` job carries no inline
# retry flags of its own).
test --flaky_test_attempts=//test/e2e:latency@3
test --flaky_test_attempts=//test/e2e:iiif_compliance@3
test --flaky_test_attempts=//test/e2e:resource_limits@3
test --flaky_test_attempts=//test/e2e:memory_budget@3
test --flaky_test_attempts=//test/e2e:server@3
test --flaky_test_attempts=//test/e2e:upload@3

# ── Remote build execution (NativeLink VM) ──────────────────────────────────
# The self-hosted NativeLink VM is the Bazel backend: Remote Cache + Remote
# Execution (mTLS). Clients reach it through the proxy on
# grpcs://rbe-01.ops.dasch.swiss:443, in front of NativeLink's internal :50051.
# In CI the connection + mTLS flags are built by the `bazel-rbe` composite
# action and injected per step (Bazel does NOT expand env vars in .bazelrc, so
# they live in the workflow, not here):
#   --remote_cache / --remote_executor=grpcs://<host>:443
#   --tls_certificate / --tls_client_certificate / --tls_client_key
# No --experimental_remote_downloader: Bazel fetches the FetchBlob digest's
# bytes from the --remote_cache CAS (GrpcRemoteDownloader.java hands the
# digest to the remoteCacheClient), so a gRPC downloader is only usable when
# it shares a CAS with the remote cache; NativeLink has no fetch-on-miss
# asset service. External archives are cached by --repository_cache below +
# a per-runner actions/cache step in CI.
# The connection flags come from the `bazel-rbe` action in CI and from the
# opt-in --config=rbe-darwin locally; the tuning flags below are no-ops without
# a remote configured.
#   --remote_download_minimal: only fetch outputs of explicitly-built targets;
#     intermediate action outputs stay in the CAS (build-without-the-bytes).
#   --remote_local_fallback: if the VM is unreachable, build locally instead of
#     failing — a VM outage degrades wall-clock, never breaks CI. Cross legs
#     turn it off (rbe-cross below).
#   --remote_timeout=600s: per-request budget sized for cold native-dep compiles
#     on the worker (far longer than a cache-only round-trip).
#   --remote_max_connections=200: raises the gRPC parallelism ceiling for fast
#     bulk lookup at build-graph evaluation time. Doubled alongside the
#     composite action's --jobs bump (32->128) so the connection pool doesn't
#     throttle before the backend's own capacity does.
# No --remote_cache_compression: NativeLink v1.5.2 does not advertise wire
# compression, so enabling it fails the capabilities query.
build --remote_download_minimal
build --remote_local_fallback
build --remote_timeout=600s
build --remote_max_connections=200

# Cross legs: the target is not x86_64 Linux, so compiles and exec tools run on the
# x86_64 worker and the tests run on the client. Used by the bazel-rbe action and by
# rbe-darwin. --host_platform makes rules_rust exec tools build for the worker, not the
# client (rules_rust #327).
build:rbe-cross --host_platform=//platforms:linux_x86_64
build:rbe-cross --strategy=TestRunner=local
# Do not remove: a local fallback runs the x86_64 exec tools on the client, which fails
# with "cannot execute binary file" and hides the remote error.
build:rbe-cross --noremote_local_fallback

# Opt-in remote build execution from an Apple Silicon Mac. Needs `build:dasch-rbe` in
# ~/.bazelrc ("Config value 'dasch-rbe' is not defined" means it is missing); see
# docs/src/development/rbe.md § Local use from macOS. The platform pair mirrors the
# darwin leg of .github/actions/bazel-rbe; change both together.
build:rbe-darwin --config=dasch-rbe
build:rbe-darwin --config=rbe-cross
# After dasch-rbe so it wins: laptop results never enter the cache CI reads.
build:rbe-darwin --noremote_upload_local_results
build:rbe-darwin --platforms=//platforms:darwin_aarch64
build:rbe-darwin --extra_execution_platforms=//platforms:linux_x86_64,//platforms:darwin_aarch64
build:rbe-darwin --remote_download_toplevel

# Content-addressed cache of external downloads (http_archive tarballs, bzlmod
# registry files). Bazel's default repository cache lives under the
# output_user_root; pinning an explicit stable path lets CI persist it across
# runs via actions/cache (keyed on MODULE.bazel.lock) and gives local dev one
# shared location across workspaces.
common --repository_cache=~/.cache/bazel-repo

# Mirror fallbacks for single-host upstream distfiles (www.lua.org,
# www.cl.cam.ac.uk, www.digip.org — the first two failed CI within one
# 2026-08-04 window on every leg whose repository cache didn't already hold
# the tarball). Pinned checksums verify every candidate, so mirrors add
# availability, never trust. See the config file for the rewrite semantics. The path must stay relative:
# Bazel resolves it against the workspace root itself
# (BazelRepositoryModule passes env.getWorkspace() to the UrlRewriter), and
# %workspace% is NOT expanded for this flag — the literal token fails
# every command at startup.
common --downloader_config=bazel/downloader.cfg

# BCR curl ships with three configurable TLS backends (boringssl default,
# mbedtls, openssl) selected via a `string_flag`. Pin to `openssl` so the
# resolved cc dep is `@openssl//:{ssl,crypto}` rather than BoringSSL —
# sipi links real OpenSSL elsewhere (src/util checksum digests), and a mixed
# include path causes the BoringSSL `openssl/evp.h` to shadow the real
# OpenSSL header.
build --@curl//:ssl_lib=openssl

# ── User overrides ─────────────────────────────────────────────────────────
# Local-machine-only flags (e.g. --disk_cache=...) belong in user.bazelrc;
# the file is gitignored.
try-import %workspace%/user.bazelrc
