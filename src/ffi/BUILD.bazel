"""src/ffi — the narrow C FFI seam between the Rust shell and the C++ engine (ADR-0013, ADR-0020).

`sipi_ffi.h` is the durable `extern "C"` contract the Rust shell drives the C++
image engine through; the response is streamed through `SipiResponse`
callbacks rather than returned in a struct, and no C++ exception crosses the
boundary. Lives in its own Bazel package so the seam is a build-graph
invariant and so the `rust_binary` can link this `cc_library` (via
rules_rust `link_deps`) as a defined unit. (It is not dependency-free:
the `//src/util` dep below pulls libmagic transitively; as the engine
slices land behind the FFI the target grows rather than shrinks.)

`include_prefix = "ffi"` + `strip_include_prefix = "/src/ffi/cpp"` exposes the
header at `#include "ffi/sipi_ffi.h"` self-sufficiently (ADR-0003). Siblings
within the package use the bare quote form (`#include "sipi_ffi.h"`).

The target hosts the C++ side of the seam; its `srcs` grow as the engine is
carved behind the FFI (today: `sipi_serve_file` / `sipi_serve_image` /
`sipi_serve_timings_take` / `sipi_phase_count` / `sipi_metrics_snapshot`,
and the `sipi_image_*` handle family the Rust-hosted Lua runtime drives).
"""

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "sipi_ffi",
    srcs = [
        # serve_response.{h,cpp} is the misuse-resistant C++ layer over the C
        # ABI (variant body, pure build_*, single apply driver, sipi_guard);
        # serve_image.{h,cpp} carves the IIIF decode pipeline behind the seam;
        # engine_context.{h,cpp} holds the engine services/config the pipeline
        # reads; sipi_ffi.cpp is the thin extern "C" surface (incl.
        # sipi_metrics_snapshot, which fills the SipiMetricsSnapshot layout
        # defined in metrics_snapshot.h); image_handle.cpp is the opaque
        # sipi_image_* handle family the Rust-hosted Lua SipiImage bindings
        # drive.
        # decode_guard.{h,cpp} is the single decode-guard chokepoint shared by
        # serve_image.cpp and image_handle.cpp: the DEV-7080 deadline watchdog
        # plus the full-lane memory-budget acquire/guard lane, so there is
        # exactly one acquire site for either decode entry point (S2-20).
        "cpp/decode_guard.cpp",
        "cpp/engine_context.cpp",
        # init.cpp is the production `sipi_init` engine install; it lives in
        # //src/ffi, not //src/cli, so no production FFI entry lives in the CLI
        # label; startup.cpp holds the LibraryInitialiser + memory-detection
        # helpers it shares with the CLI dispatch (dependency runs cli -> ffi).
        "cpp/init.cpp",
        "cpp/serve_image.cpp",
        "cpp/serve_response.cpp",
        "cpp/serve_timings.cpp",
        "cpp/image_handle.cpp",
        "cpp/sipi_ffi.cpp",
        "cpp/startup.cpp",
        # SipiConf is the Lua-flavoured config object init.cpp constructs and
        # populates before installing the engine context; it has no consumer
        # outside this package.
        "cpp/SipiConf.cpp",
    ],
    hdrs = [
        "cpp/decode_guard.h",
        "cpp/engine_context.h",
        "cpp/metrics_snapshot.h",
        "cpp/serve_image.h",
        "cpp/serve_response.h",
        "cpp/serve_timings.h",
        "cpp/sipi_ffi.h",
        "cpp/startup.h",
        "cpp/SipiConf.h",
    ],
    include_prefix = "ffi",
    strip_include_prefix = "/src/ffi/cpp",
    # -fexceptions: the catch-all guard in each entry point relies on
    # exceptions being enabled so a codec/std throw becomes a status code
    # instead of unwinding across the C ABI (FFI contract).
    copts = ["-fexceptions"],
    deps = [
        # SipiValueError + policy_for (ADR-0024): serve_image.{h,cpp}'s
        # status_for/report_value_error convert a value error into the seam's
        # SipiStatus / SipiImageErrorReport. Reached transitively today via
        # //src/image, but declared explicitly per this repo's rule that a
        # consuming target states what it includes.
        "//src/error",
        # The transport-free image engine (SipiImage, memory budget) the
        # IIIF pipeline drives, with the IIIF value objects
        # (//src/iiifparser/cpp/value_objects) reached transitively. //src/image
        # does NOT depend on this package, so there is no cycle.
        "//src/image",
        # Free-function geometry operators (crop/scale/rotate/set_topleft)
        # image_handle.cpp and serve_image.cpp drive over SipiImage.
        "//src/image_processing",
        # The serve-time cache SipiCache. init.cpp constructs the single
        # instance; serve_image.cpp calls check/add. Independent of
        # //src/image (SipiCache has no dependency on SipiImage).
        "//src/cache",
        # The codec handlers. serve_image.cpp calls SipiImage::read/write, whose
        # `io` handler registry is defined in //src/format_handlers (moved there to
        # break the SipiImage<->handler cycle); this dep puts that definition —
        # and the four SipiIO* handlers it instantiates — on the link line.
        "//src/format_handlers:format_handlers",
        # generated/SipiVersion.h — the Bazel build stamp the seam hands to the
        # shell for its OTel resource attributes (sipi_build_version/commit).
        "//src:sipi_generated_hdrs",
        # Sentry error capture + the Prometheus metric counters serve_image emits.
        "//src/observability:observability",
        # Icc / predefined ICC profiles for the quality colour conversions.
        "//src/metadata:metadata",
        # log_warn/log_info/... in the decode pipeline.
        "//src/logging:logging",
        # shttps::Parsing::getBestFileMimetype / getFileMimetype (the libmagic
        # MIME sniff) + shttps::urldecode. Generic SIPI-domain utilities, not the
        # HTTP transport, so this is no SIPI -> shttps-transport coupling.
        "//src/util",
        # startup.cpp's LibraryInitialiser initialises these directly (curl_global_init,
        # Exiv2::XmpParser). Both also arrive transitively via //src/image; named
        # here because startup.cpp includes their headers directly.
        "@curl",
        "@exiv2//:exiv2",
    ],
)

# Co-located unit test (ADR-0003) for the pure serve-response builder — the Range
# parse/clamp + status/header derivation, exercised without a transport.
cc_test(
    name = "serve_response_test",
    srcs = ["cpp/serve_response_test.cpp"],
    deps = [
        ":sipi_ffi",
        "@googletest//:gtest_main",
    ],
)

# Co-located unit test for the transport-pure IIIF response builder (build_image_response):
# body shape (FileBody/StreamBody/EmptyBody), pre-commit status codes, and the
# decoded output of restricted requests (SipiImage reads the drained body; a
# real SipiCache counts entries). Fixture paths resolve via //test:test_paths,
# which honours SIPI_WORKSPACE_ROOT.
cc_test(
    name = "serve_image_test",
    srcs = ["cpp/serve_image_test.cpp"],
    data = ["//test/_test_data:images"],
    env = {"SIPI_WORKSPACE_ROOT": "."},
    deps = [
        ":sipi_ffi",
        "//src/cache",
        "//src/image",
        "//src/metadata",
        "//test:test_paths",
        "@googletest//:gtest_main",
    ],
)

# Co-located unit test for the edge-probe seam entries (sipi_imgroot /
# sipi_prefix_as_path read the installed engine context; sipi_image_dims /
# sipi_mimetype read a validated fixture). Fixture paths resolve via
# //test:test_paths, which honours SIPI_WORKSPACE_ROOT.
cc_test(
    name = "seam_probe_test",
    srcs = ["cpp/seam_probe_test.cpp"],
    data = ["//test/_test_data:images"],
    env = {"SIPI_WORKSPACE_ROOT": "."},
    deps = [
        ":sipi_ffi",
        "//test:test_paths",
        "@googletest//:gtest_main",
    ],
)

# Co-located unit test for the per-phase serve-timing accumulator: exercises
# serve_timings_reset/export + the RAII PhaseTimer directly (present/failed flags,
# overwrite-on-retime, reset clearing, out-of-range no-op), without a transport.
cc_test(
    name = "serve_timings_test",
    srcs = ["cpp/serve_timings_test.cpp"],
    deps = [
        ":sipi_ffi",
        "@googletest//:gtest_main",
    ],
)

# Co-located unit test for sipi_metrics_snapshot: bump the Metrics singleton
# counters/gauges, snapshot, assert the struct fields ferry them (counter deltas
# + the signed -1 cache-size-limit gauge). Deps the observability target directly
# to drive the singleton.
cc_test(
    name = "metrics_snapshot_test",
    srcs = ["cpp/metrics_snapshot_test.cpp"],
    deps = [
        ":sipi_ffi",
        "//src/observability:observability",
        "@googletest//:gtest_main",
    ],
)
