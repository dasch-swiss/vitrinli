"""Sipi CLI binary + the CLI app library behind the FFI seam.

`//src/cli:cli_app` is the `cc_library` that owns the CLI11 app and every
offline subcommand body (`convert`/`verify`/`query`/`compare`/`health`),
exposed through the `extern "C" sipi_cli_main` entry declared in
`ffi/sipi_ffi.h`. It lives in its own library — separate from the binary's
`main` translation unit — so the Rust HTTP shell (`//src/server/rust`) can link
it and call `sipi_cli_main` for the offline subcommands without colliding with
Rust's own `main`.

`//src/cli:sipi` is the thin `cc_binary` for the sipi executable: its only
translation unit is `sipi.cpp`, whose `main` just calls `sipi_cli_main`.

`//src/cli:sipi_report` holds the offline verbs' JSON report emitter
(`SipiReport.h`/`.cpp`). It is a separate leaf target rather than folded into
`:cli_app` because `:cli_app` depends one-way on `//src/cli/cpp/commands:commands`
(`convert_access_file.cpp` reports through it too) — a dependency back from
`commands` to `cli_app` would cycle. `include_prefix = "cli"` + `strip_include_prefix
= "/src/cli/cpp"` exposes the header at `#include "cli/SipiReport.h"` (ADR-0003);
both `:cli_app` and `//src/cli/cpp/commands:commands` depend on it directly.

System-lib + framework linkopts (`-ldl`, `-lpthread`, `-liconv`,
`-framework SystemConfiguration`, `-framework CoreFoundation`) are declared on
`:sipi_lib` so they propagate to every downstream binary and cc_test. This
binary keeps only its own binary-specific flag (`--build-id=sha1`) and the
distroless libc++ static-link bracket.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "sipi_report",
    srcs = ["cpp/SipiReport.cpp"],
    hdrs = ["cpp/SipiReport.h"],
    include_prefix = "cli",
    strip_include_prefix = "/src/cli/cpp",
    visibility = ["//src/cli:__subpackages__"],
    deps = [
        # error_code_name's ErrorCode.
        "//src/error",
        # populate_from_image.h's observability::ImageContext, the struct
        # the report mirrors.
        "//src/image",
        # get_correlation_id, carried by every document.
        "//src/logging",
        "@jansson//:jansson",
    ],
)

# Colocated unit test (ADR-0003).
cc_test(
    name = "sipi_report_test",
    srcs = ["cpp/SipiReport_test.cpp"],
    deps = [
        ":sipi_report",
        "//src/error",
        "//src/image",
        "//src/logging",
        "@googletest//:gtest_main",
        "@jansson//:jansson",
    ],
)

cc_library(
    name = "cli_app",
    srcs = ["cpp/cli_app.cpp"],
    # -fexceptions: sipi_cli_main is an FFI entry; CLI dispatch + the engine
    # throw, and those must not unwind across the extern "C" boundary.
    copts = ["-fexceptions"],
    visibility = ["//src/cli/rust:__pkg__"],
    deps = [
        "//src:sipi_lib",
        "//src/cli/cpp/commands:commands",
        # The sipi_cli_main declaration (the extern "C" seam contract).
        "//src/ffi:sipi_ffi",
        # cli_app.cpp's rotate calls (orientation normalisation, --mirror/--rotate).
        "//src/image_processing",
        ":sipi_report",
        # cli_app.cpp's `#include <CLI/CLI.hpp>` — the sole CLI11 consumer.
        "@cli11//:cli11",
    ],
)

cc_binary(
    name = "sipi",
    srcs = [
        "cpp/sipi.cpp",
    ],
    linkopts = select({
        "@platforms//os:linux": [
            # Content-addressed build-id for reproducible debug-info
            # splitting in Y+4. `--build-id=sha1` derives the build-id
            # from the binary's content hash rather than a wall-clock
            # random; identical inputs ↔ identical build-id.
            "-Wl,--build-id=sha1",
            # Static-link libc++ runtime so the binary runs in
            # distroless/base-debian12 (the production image), which
            # ships only glibc + cacert + tzdata + openssl — there is
            # no libc++.so.1 there for the dynamic loader to find.
            # Without these flags sipi exits silently on first
            # syscall under distroless. The archives come from the
            # hermetic toolchain, so an `llvm.version` bump changes the
            # embedded libc++ with no change to the image.
            #
            # `-Wl,-Bstatic … -Wl,-Bdynamic` brackets these three
            # archives only — system libs (`-lpthread`, `-lm`, `-ldl`)
            # added by the toolchain after our linkopts stay dynamic.
            "-Wl,-Bstatic",
            "-lc++",
            "-lc++abi",
            "-lunwind",
            "-Wl,-Bdynamic",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//test/e2e:__pkg__"],
    deps = [
        # The CLI app behind the FFI seam (also pulls //src/ffi:sipi_ffi for
        # the sipi_cli_main declaration and the system/framework linkopts via
        # :sipi_lib).
        ":cli_app",
    ],
)

package(default_visibility = ["//visibility:private"])
