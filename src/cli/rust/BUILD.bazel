"""src/cli/rust — the default `sipi` binary, the production entry point.

`//src/cli/rust:sipi` is the stock binary that wraps the `sipi` library
(`//src/server/rust:lib`): it owns `main` + the verb dispatch (`server` →
`sipi::run`; every other argv → `sipi_cli_main`). It performs the FINAL link of
the C++ image engine — pulled transitively through `//src/server/rust:lib`'s
`//src/ffi:sipi_ffi` dep — plus the C++ CLI app (`//src/cli:cli_app`) for
`sipi_cli_main`. The engine is linked once (Bazel dedups the shared archives).

`cli/rust` binds only the `sipi_cli_main` C-ABI symbol (`src/ffi.rs`); the server
seam stays in `//src/server/rust`. Dependencies resolve from the single `@crates`
crate_universe `from_specs` hub (direct deps in `MODULE.bazel`, no `Cargo.toml`)
as `@crates//:<crate>` labels. Repin via:
`CARGO_BAZEL_REPIN=1 bazelisk fetch @crates//:all`.
"""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# The final binary link pulls in the C++ engine archives (via
# //src/server/rust:lib → //src/ffi:sipi_ffi) and the C++ CLI app, but rustc
# drives the link with the C linker driver, which does NOT auto-link the C++
# standard library the way the `clang++` driver does for //src/cli:sipi. We
# append `-lc++` / `-lc++abi` as trailing `-Clink-arg`s so they resolve the
# engine's libc++ symbols AFTER the archives that reference them (trailing
# position is required for static-archive ordering on Linux). Linux statically
# links the libc++ runtime + unwinder, matching //src/cli:sipi's distroless link
# surface (no libc++.so.1 in base-debian12). macOS needs only `-lc++`:
# libc++abi's symbols are re-exported by the system `libc++.dylib`.
_CPP_STDLIB_LINK = select({
    "@platforms//os:macos": [
        "-Clink-arg=-lc++",
    ],
    "@platforms//os:linux": [
        # Content-addressed build-id, mirroring //src/cli:sipi's linkopt.
        # `//src:sipi_debug_split` reads this from `.note.gnu.build-id` to
        # split stripped binary + `.debug` and lay the debug file out under
        # `lib/debug/.build-id/<xx>/<yy>.debug` for `sentry-cli debug-files
        # upload`. `=sha1` derives the id from the binary's content hash
        # (not a wall-clock random), so identical inputs ↔ identical build-id
        # — the gate for byte-reproducible OCI tarballs. Without it the split
        # genrule errors ("no Build ID"). ELF-only: ld64 on macOS rejects
        # `--build-id` (macOS uses dSYM bundles, out of scope here).
        "-Clink-arg=-Wl,--build-id=sha1",
        "-Clink-arg=-Wl,-Bstatic",
        "-Clink-arg=-lc++",
        "-Clink-arg=-lc++abi",
        "-Clink-arg=-lunwind",
        "-Clink-arg=-Wl,-Bdynamic",
    ],
    "//conditions:default": [],
})

# rustc links Apple targets with `-nodefaultlibs`, so clang reports BCR modules'
# `-pthread` linkopt as unused and rustc's `linker_messages` lint prints it.
_DARWIN_QUIET_LINK = select({
    "@platforms//os:macos": ["-Clink-arg=-Wno-unused-command-line-argument"],
    "//conditions:default": [],
})

_SRCS = [
    "src/commands/health.rs",
    "src/commands/mod.rs",
    "src/commands/server/args/cache.rs",
    "src/commands/server/args/concurrency.rs",
    "src/commands/server/args/knora.rs",
    "src/commands/server/args/limits.rs",
    "src/commands/server/args/logging.rs",
    "src/commands/server/args/mod.rs",
    "src/commands/server/args/network.rs",
    "src/commands/server/args/paths.rs",
    "src/commands/server/args/tls_auth.rs",
    "src/commands/server/mod.rs",
    "src/ffi.rs",
    "src/main.rs",
]

# Process-wide allocator: mimalloc v3 (vendored, `bazel/mimalloc.BUILD.bazel`)
# statically linked as the malloc/free override on Linux (what production
# runs); macOS dev builds stay on the system allocator. The library is
# alwayslink, so the override objects are whole-archived ahead of the
# lazily-scanned libc++abi/libc. The allocator belongs on the final-link
# target only: a dep on //src/ffi:sipi_ffi would leak it into every cc_test
# and the glibc-baselined C++ engine binary //src/cli:sipi. main.rs verifies
# interposition at startup (a partially interposed process is latent heap
# corruption). See docs/adr/0019-mimalloc-production-allocator.md.
#
# Never under ASan: AddressSanitizer interposes malloc/free with its own
# allocator, and two interposers in one binary is undefined behavior. The
# `mimalloc` crate feature carries the same condition into the Rust source, so
# the interposition probe and stats reader drop out together with the dep.
config_setting(
    name = "linux_sans_asan",
    constraint_values = ["@platforms//os:linux"],
    flag_values = {"@llvm//config:asan": "false"},
    visibility = ["//visibility:private"],
)

# The mimalloc stats read (`sipi.malloc.*` gauges) goes through this one-function
# C shim so `mi_stats_get` and `mi_process_info` are compiler-checked against the
# exact @mimalloc pin. Rust-side `extern "C"` re-declarations of mimalloc's stats
# API are banned: nothing verifies them against the header, and a declaration
# drifting from the pinned version segfaults the metrics thread at the first
# collection instead of failing the build.
cc_library(
    name = "mi_stats_shim",
    srcs = ["mi_stats_shim.c"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:private"],
    deps = ["@mimalloc//:mimalloc"],
)

_ALLOCATOR = select({
    ":linux_sans_asan": [
        ":mi_stats_shim",
        "@mimalloc//:mimalloc",
    ],
    "//conditions:default": [],
})

_ALLOCATOR_FEATURE = select({
    ":linux_sans_asan": ["mimalloc"],
    "//conditions:default": [],
})

# `crash-handler` (a `sentry-rust-minidump` dependency) interposes
# `pthread_create` with a strong, `dlsym(RTLD_NEXT, ...)`-forwarding symbol to
# install its per-thread alternate signal stack. ASan's own `pthread_create`
# interceptor is a weak alias, so in a static link crash-handler's strong
# symbol wins and ASan's `InterceptFunction` fails silently: spawned threads
# never register with ASan/LSan, and ASan's (still-intercepted) `pthread_join`
# then aborts on those threads with "Joining already joined thread". The
# `minidump` crate feature carries the same condition into the Rust source, so
# the minidump init call drops out together with the dep — under ASan, native
# faults are reported by ASan itself instead.
config_setting(
    name = "sans_asan",
    flag_values = {"@llvm//config:asan": "false"},
    visibility = ["//visibility:private"],
)

_CRASH_REPORTER = select({
    ":sans_asan": ["@crates//:sentry-rust-minidump"],
    "//conditions:default": [],
})

_CRASH_REPORTER_FEATURE = select({
    ":sans_asan": ["minidump"],
    "//conditions:default": [],
})

rust_binary(
    name = "sipi",
    srcs = _SRCS,
    crate_features = _ALLOCATOR_FEATURE + _CRASH_REPORTER_FEATURE,
    crate_name = "sipi_cli",
    edition = "2021",
    rustc_flags = _CPP_STDLIB_LINK + _DARWIN_QUIET_LINK,
    # Excluded from the sanitizer build (ci.yml's `sanitizer` job filters `-no-sanitizer`):
    # the transitive C++ dep (protobuf) includes <sanitizer/asan_interface.h>
    # under --config=asan, which the hermetic LLVM toolchain does not ship.
    tags = ["no-sanitizer"],
    visibility = [
        "//src:__pkg__",
        "//test/e2e:__pkg__",
    ],
    deps = [
        "@crates//:clap",
        "@crates//:libc",
        "@crates//:rustls",
        "@crates//:sentry",
        # The `sipi` server library (the `server` verb → sipi::run). Carries the
        # C++ image engine via //src/ffi:sipi_ffi.
        "//src/server/rust:lib",
    ] + _CRASH_REPORTER,
    link_deps = [
        # The C++ CLI app behind the FFI seam — provides `sipi_cli_main` (offline
        # verbs) + the system/framework linkopts via //src:sipi_lib.
        "//src/cli:cli_app",
    ] + _ALLOCATOR,
)

# Compiles the binary crate with --cfg test; it performs the same final link of
# the C++ engine archives as the binary, so it needs the C++ stdlib link bracket
# and the same `no-sanitizer` exclusion.
rust_test(
    name = "sipi_unit_test",
    crate = ":sipi",
    crate_features = _ALLOCATOR_FEATURE + _CRASH_REPORTER_FEATURE,
    edition = "2021",
    rustc_flags = _CPP_STDLIB_LINK + _DARWIN_QUIET_LINK,
    tags = ["no-sanitizer"],
    visibility = ["//visibility:private"],
)

package(default_visibility = ["//visibility:private"])
