"""src/server/rust — the `sipi` HTTP-server library, the production server (ADR-0020).

The `sipi` `rust_library` (`//src/server/rust:lib`, crate `sipi`) owns the axum +
tokio server and statically links the C++ image engine through the FFI seam
(`//src/ffi:sipi_ffi`, a `cc_library`). The default `sipi` binary that wraps it
lives in `//src/cli/rust` — this package is library-only.

This is the first Rust → C++ link in the graph: `rules_rust` threads the seam's
`CcInfo` (and the engine's transitive linkopts: `-ldl`/`-lpthread` on Linux, the
iconv + CoreFoundation/SystemConfiguration frameworks on macOS) through to the
final binary link, which happens in `//src/cli/rust`. `//src/ffi:sipi_ffi` pulls
`//src/image`, so the library carries the engine on its own — it no longer
depends on the C++ CLI (`//src/cli:cli_app`); `//src/cli/rust` adds that for
`sipi_cli_main`.

Dependencies resolve from the single `@crates` crate_universe `from_specs` hub
(direct deps declared in `MODULE.bazel`, no `Cargo.toml`); this library
references the subset it needs as `@crates//:<crate>` labels. Repin via:
`CARGO_BAZEL_REPIN=1 bazelisk fetch @crates//:all`.
"""

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//src/cli/rust:__pkg__"])

rust_library(
    name = "lib",
    srcs = [
        "src/config.rs",
        "src/config_file.rs",
        "src/ffi.rs",
        "src/info.rs",
        "src/lib.rs",
        "src/malloc_stats.rs",
        "src/metrics.rs",
        "src/path.rs",
        "src/preflight_cache.rs",
        "src/routes.rs",
        "src/sink.rs",
        "src/telemetry.rs",
    ],
    crate_name = "sipi",
    edition = "2021",
    # The favicon bytes `favicon()` embeds at compile time via `include_bytes!`.
    compile_data = ["src/favicon.ico"],
    deps = [
        "@crates//:axum",
        "@crates//:axum-tracing-opentelemetry",
        "@crates//:cookie",
        "@crates//:form_urlencoded",
        "@crates//:httpdate",
        "@crates//:init-tracing-opentelemetry",
        "@crates//:libc",
        "@crates//:opentelemetry",
        "@crates//:opentelemetry-appender-tracing",
        "@crates//:opentelemetry-otlp",
        "@crates//:opentelemetry_sdk",
        "@crates//:percent-encoding",
        "@crates//:sentry",
        "@crates//:sentry-tracing",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:toml",
        "@crates//:tower",
        "@crates//:tower-http",
        "@crates//:tracing",
        "@crates//:tracing-opentelemetry",
        "@crates//:tracing-subscriber",
        # The pure-CPU IIIF URL parser (domain types; no FFI). `server/rust` owns
        # the `From<iiif_parser::IiifParams> for SipiIiifParams` flattening.
        "//src/iiifparser/rust:iiif_parser",
        # The Rust-hosted Lua runtime (ADR-0023): config-VM parse of the Lua
        # config and the per-request VM that runs Lua routes and preflight.
        "//src/scripting/rust:scripting",
        # The FFI-free two-lane admission pool (classify + acquire + per-partition
        # counters). Owned by `AppState`; `routes.rs` keeps only the call sites.
        "//src/throttling/rust:admission",
    ],
    link_deps = [
        # The narrow C FFI seam → the transitive C++ image engine. This is the
        # cc_library → rust link (Open Question #1). //src/ffi:sipi_ffi pulls
        # //src/image, so the library carries the engine without depending on
        # the C++ CLI.
        "//src/ffi:sipi_ffi",
    ],
    # Excluded from the sanitizer build (ci.yml's `sanitizer` job filters `-no-sanitizer`):
    # this library is the carrier of the transitive C++ dep (protobuf/abseil)
    # whose source includes a <sanitizer/*.h> header the hermetic LLVM toolchain
    # does not ship under --config=asan. It is a top-level target in the
    # `//src/...` test glob, so it must be tagged or the asan unit step still
    # builds it and fails.
    tags = ["no-sanitizer"],
)

# The C++ stdlib link bracket — needed by any target that performs the FINAL
# link of the C++ engine archives under rustc's C linker driver (which, unlike
# the `clang++` driver, does not auto-link libc++). The library is not linked on
# its own (it produces an rlib), but the unit test below is; the production
# binary applies the same flags in //src/cli/rust. macOS needs only `-lc++`
# (libc++abi's symbols are re-exported by the system `libc++.dylib`); Linux
# statically links the libc++ runtime + unwinder to match `//src/cli:sipi`'s
# distroless link surface (no libc++.so.1 in base-debian12). Trailing position
# is required for static-archive ordering on Linux.
_CPP_STDLIB_LINK = select({
    "@platforms//os:macos": [
        "-Clink-arg=-lc++",
    ],
    "@platforms//os:linux": [
        "-Clink-arg=-Wl,-Bstatic",
        "-Clink-arg=-lc++",
        "-Clink-arg=-lc++abi",
        "-Clink-arg=-lunwind",
        "-Clink-arg=-Wl,-Bdynamic",
    ],
    "//conditions:default": [],
})

# rustc links Apple targets with `-nodefaultlibs`, so clang reports BCR modules'
# `-pthread` linkopt as unused and rustc's `linker_messages` lint prints it.
_DARWIN_QUIET_LINK = select({
    "@platforms//os:macos": ["-Clink-arg=-Wno-unused-command-line-argument"],
    "//conditions:default": [],
})

# Inline #[cfg(test)] unit tests (the IIIF parser unit tests). Compiles the
# library crate with --cfg test; needs the C++ stdlib link args because it
# links the same cc deps as the library.
rust_test(
    name = "sipi_unit_test",
    crate = ":lib",
    edition = "2021",
    rustc_flags = _CPP_STDLIB_LINK + _DARWIN_QUIET_LINK,
    tags = ["no-sanitizer"],  # see :lib — protobuf won't compile under --config=asan
)
